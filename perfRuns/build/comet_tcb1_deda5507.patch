diff --git a/magma_patch/_platform_init.sh b/magma_patch/_platform_init.sh
index e735fc49..028bffaa 100644
--- a/magma_patch/_platform_init.sh
+++ b/magma_patch/_platform_init.sh
@@ -43,6 +43,7 @@ local COMET_PLATFORM=""
 [[ "$COMET_HOST" = "juwels" ]] && COMET_PLATFORM=JUWELS_BOOSTER # Juelich A100 system
 [[ "$COMET_HOST" = "jwlogin" ]] && COMET_PLATFORM=JUWELS_BOOSTER # Juelich A100 system
 [[ "$COMET_HOST" = "spock" ]] && COMET_PLATFORM=SPOCK # Juelich A100 system
+[[ "$COMET_HOST" = "daint" ]] && COMET_PLATFORM=ALPS_GH200 # CSCS Alps/Daint GH200
 
 echo "COMET_HOST=${COMET_HOST} COMET_PLATFORM=${COMET_PLATFORM}"
 
@@ -1153,6 +1154,55 @@ elif [ $COMET_PLATFORM = SPOCK ] ; then
   #XXX local COMET_TEST_COMMAND="env OMP_NUM_THREADS=2 srun -N 2 --ntasks-per-node=48"
   #XXX local COMET_TEST_COMMAND="env OMP_NUM_THREADS=2 srun -N 1 --ntasks-per-node=1"
 
+#----------------------------------------
+elif [ $COMET_PLATFORM = ALPS_GH200 ] ; then
+#----------------------------------------
+
+  # CSCS Alps/Daint, GH200 (aarch64 Neoverse V2 + H100). No modules: run the configure
+  # and build under "uenv run prgenv-gnu/25.6:v2 --view=default --" (gcc 14, CUDA 12.9).
+  # Hopper has no native INT4/B1 tensor-core MMA, so CUTLASS 2.10 runs its Sm80 path.
+
+  local COMET_CAN_USE_MPI=OFF
+
+  #---Compiler.
+
+  local USE_GCC=ON
+  local COMET_C_COMPILER=$(which gcc) # presently unused
+  local COMET_CXX_COMPILER=$(which g++) # presently unused
+  local COMET_CXX_SERIAL_COMPILER=g++
+  local COMET_EXTRA_COMPILE_OPTS=" -std=gnu++17"
+
+  local USE_OPENMP=ON
+  local COMET_OPENMP_COMPILE_OPTS="-fopenmp"
+
+  local COMET_USE_INT128=ON
+
+  #---Libraries.
+
+  local USE_CUDA=ON
+  # The CUDA package itself, not the uenv view (/user-environment/env/default): the view's
+  # include dir also carries Cray MPICH's mpi.h, which would shadow the mpi-stub header.
+  local CUDA_ROOT=$(dirname $(dirname $(readlink -f $(which nvcc))))
+  # CUB comes from the toolkit (cmake.sh skips the vendored 1.8.0 here); the extra
+  # include dir serves the sources' bare #include "cub.cuh".
+  local COMET_CUDA_COMPILE_OPTS="-I$CUDA_ROOT/include -I$CUDA_ROOT/include/cub"
+  local COMET_CUDA_LINK_OPTS="-L$CUDA_ROOT/lib64 -Wl,-rpath=$CUDA_ROOT/lib64 -lcublas -lcudart"
+  local COMET_CUDA_CMAKE_OPTS="-DCUDA_PROPAGATE_HOST_FLAGS:BOOL=ON"
+  COMET_CUDA_CMAKE_OPTS+=" -DCUDA_TOOLKIT_ROOT_DIR:PATH=$CUDA_ROOT"
+  # COMET_GPU_ARCH only picks the hand-tuned tile shapes (75 -> Turing, 80 -> Ampere); there
+  # are no Hopper ones, so use Ampere's and compile for sm_90.
+  local COMET_GPU_ARCH=80
+  COMET_CUDA_CMAKE_OPTS+=" -DCUDA_NVCC_FLAGS:STRING=-gencode;arch=compute_90,code=sm_90;-lineinfo"
+
+  local USE_CUTLASS=ON
+  local COMET_COMPUTE_CAPABILITY=900
+
+  local USE_MAGMA=OFF
+
+  #---Testing.
+
+  local COMET_TEST_COMMAND="env OMP_NUM_THREADS=1"
+
 #----------------------------------------
 else
 #----------------------------------------
