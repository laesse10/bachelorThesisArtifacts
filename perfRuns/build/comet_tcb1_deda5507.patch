+    sed -i 's/^\(  *\)memcpy(recvbuf, sendbuf,/\1if (sendbuf != MPI_IN_PLACE) memcpy(recvbuf, sendbuf,/' \
+      mpi-stub/src/mpi.c
     pushd mpi-stub
     make CC=$CXX_COMPILER
     popd
