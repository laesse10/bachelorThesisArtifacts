diff --git a/deps/nsparse-um/include/nsparse/detail/count_nz.cuh b/deps/nsparse-um/include/nsparse/detail/count_nz.cuh
index fbceb16..7c97a71 100644
--- a/deps/nsparse-um/include/nsparse/detail/count_nz.cuh
+++ b/deps/nsparse-um/include/nsparse/detail/count_nz.cuh
@@ -176,7 +176,12 @@ __global__ void count_nz_pwarp_row(
     }
   }
 
-  auto mask = __activemask();
+  // A static mask of this row's pwarp lanes. __activemask() after the divergent hash loop
+  // need not contain the whole group under independent thread scheduling; the group is
+  // always complete here, since its lanes share rid and leave together on rid >= n_rows.
+  static_assert(pwarp <= 32 && (pwarp & (pwarp - 1)) == 0);
+  const unsigned mask = ((pwarp == 32) ? 0xffffffffu : ((1u << pwarp) - 1u))
+                        << ((threadIdx.x % 32u) / pwarp * pwarp);
   for (auto j = pwarp / 2; j >= 1; j /= 2) {
     nz += __shfl_xor_sync(mask, nz, j);
   }
